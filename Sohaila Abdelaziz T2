// -----------------------------------------------------------------------------
// PART 3: INT VECTOR (RULE OF FIVE IMPLEMENTATION)
// -----------------------------------------------------------------------------

class IntVector {
private:
    int* data;
    size_t capacity;
    size_t length;

    void reallocate(size_t new_capacity) {
        int* new_data = new int[new_capacity];
        for (size_t i = 0; i < length; ++i) {
            new_data[i] = data[i];
        }
        delete[] data;
        data = new_data;
        capacity = new_capacity;
    }

public:
    // 1. Default / Parameterized Constructor
    explicit IntVector(size_t init_cap = 4) 
        : data(new int[init_cap]), capacity(init_cap), length(0) {}

    // 2. Destructor
    ~IntVector() {
        delete[] data;
    }

    // 3. Copy Constructor (Deep Copy)
    IntVector(const IntVector& other) 
        : data(new int[other.capacity]), capacity(other.capacity), length(other.length) {
        for (size_t i = 0; i < length; ++i) {
            data[i] = other.data[i];
        }
    }

    // 4. Copy Assignment Operator (Copy-and-Swap Idiom)
    IntVector& operator=(const IntVector& other) {
        if (this != &other) {
            IntVector temp(other);
            std::swap(data, temp.data);
            std::swap(capacity, temp.capacity);
            std::swap(length, temp.length);
        }
        return *this;
    }

    // 5. Move Constructor
    IntVector(IntVector&& other) noexcept 
        : data(other.data), capacity(other.capacity), length(other.length) {
        other.data = nullptr;
        other.capacity = 0;
        other.length = 0;
    }

    // 6. Move Assignment Operator
    IntVector& operator=(IntVector&& other) noexcept {
        if (this != &other) {
            delete[] data;
            data = other.data;
            capacity = other.capacity;
            length = other.length;

            other.data = nullptr;
            other.capacity = 0;
            other.length = 0;
        }
        return *this;
    }

    void push_back(int value) {
        if (length == capacity) {
            reallocate(capacity == 0 ? 1 : capacity * 2);
        }
        data[length++] = value;
    }

    size_t size() const { return length; }
    size_t get_capacity() const { return capacity; }

    int& operator[](size_t index) { return data[index]; }
    const int& operator[](size_t index) const { return data[index]; }
};

int main() {
    demonstrateAbstractionLeak();

    std::cout << "--- Part 3: Testing IntVector (Rule of Five) ---\n";
    IntVector vec;
    vec.push_back(10);
    vec.push_back(20);
    vec.push_back(30);

    std::cout << "Vector Size: " << vec.size() << "\n";
    std::cout << "Vector Elements: ";
    for (size_t i = 0; i < vec.size(); ++i) {
        std::cout << vec[i] << " ";
    }
    std::cout << "\n\nTesting Copy Constructor:\n";
    IntVector vec_copy = vec;
    std::cout << "Copy Size: " << vec_copy.size() << "\n";

    std::cout << "\nTesting Move Constructor:\n";
    IntVector vec_moved = std::move(vec);
    std::cout << "Moved Size: " << vec_moved.size() << "\n";
    std::cout << "Original Size after Move: " << vec.size() << "\n";

